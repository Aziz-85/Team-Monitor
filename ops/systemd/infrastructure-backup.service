[Unit]
Description=Infrastructure database backups
After=docker.service postgresql.service
[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/var/www/team-monitor
EnvironmentFile=/etc/app-infrastructure/backup.env
ExecStart=/var/www/team-monitor/scripts/infrastructure/backup-database.sh team-monitor
ExecStart=/var/www/team-monitor/scripts/infrastructure/backup-database.sh aquamonitors
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/backups/app-infrastructure /var/log/app-infrastructure /var/lib/app-infrastructure /run/lock/app-infrastructure
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0027
